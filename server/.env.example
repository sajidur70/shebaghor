NODE_ENV=development
PORT=5000

# Neon → Connect → Connection pooling ON. Add &pgbouncer=true at the end.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&pgbouncer=true"
# Neon → Connect → Connection pooling OFF.
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

JWT_SECRET=paste-a-long-random-string-here-at-least-32-characters
CLIENT_URL=http://localhost:5173
SERVER_URL=http://localhost:5000

# mock = payments confirm instantly. sslcommerz = real sandbox gateway.
PAYMENT_MODE=mock
SSLC_STORE_ID=
SSLC_STORE_PASSWORD=